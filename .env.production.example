# ============================================
# CONFIGURACIÓN PARA PRODUCCIÓN / MVP
# ============================================
# Usar con servicios cloud gratuitos

# ============================================
# SUPABASE (PostgreSQL + pgvector)
# ============================================
# Obtener en: https://supabase.com > Settings > Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# ============================================
# UPSTASH (Redis)
# ============================================
# Obtener en: https://upstash.com > Create Database
REDIS_URL=redis://default:[PASSWORD]@[REGION].upstash.io:6379

# ============================================
# OPENAI
# ============================================
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# SLACK BOT (Opcional)
# ============================================
# Obtener en: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================
# OPTIMIZACIONES MVP
# ============================================
# Scraping semanal para reducir carga
SCRAPING_SCHEDULE=0 2 * * 0

# Cache de 7 días para reducir llamadas a OpenAI
RESPONSE_CACHE_TTL=604800

# Logging
LOG_LEVEL=INFO
