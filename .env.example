# ============================================
# CONFIGURACIÓN DEL SISTEMA DE CONTABILIDAD
# ============================================

# Copiar este archivo a .env y configurar los valores

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contabilidad_db

# ============================================
# CACHE (REDIS)
# ============================================
REDIS_URL=redis://localhost:6379/0

# TTL de cache de respuestas en segundos (default: 24 horas)
RESPONSE_CACHE_TTL=86400

# ============================================
# LLM - SERVICIO DE INTELIGENCIA ARTIFICIAL
# ============================================
# Opciones: "ollama" (local) o "openai" (cloud)
LLM_SERVICE=ollama

# --- Configuración Ollama (Local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Configuración OpenAI (Cloud) ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# SLACK BOT
# ============================================
# Obtener tokens desde https://api.slack.com/apps

# Token del Bot (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Token de la App para Socket Mode (xapp-...)
SLACK_APP_TOKEN=xapp-your-app-token

# Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================
# SCHEDULER - SCRAPING AUTOMÁTICO
# ============================================
# Expresión cron para scraping (default: 2 AM diario)
SCRAPING_SCHEDULE=0 2 * * *

# Máximo de documentos por sección al scrapear
MAX_DOCUMENTS_PER_SECTION=50

# ============================================
# API EXTERNA (OPCIONAL)
# ============================================
# Token para APIs de microservicios externos
BUSINESS_INVOICES_TOKEN=your-api-token

# URLs de microservicios
MONTHLY_SALES_API_URL=http://localhost:5001

# ============================================
# KAFKA (OPCIONAL)
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC=businesses.fct.update.0
KAFKA_GROUP_ID=orquestador-llm-consumer-group

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
